PORT=3000
NODE_ENV=development
# Set a long random value before production; production requires this.
SESSION_SECRET=
# These seed the admin only when the database is first created.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Server only: never expose or commit your API key.
GEMINI_API_KEY=

# Gemini model is fixed in analysis.js to gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
# Informational: analysis.js hardcodes the model and does not read GEMINI_MODEL.
